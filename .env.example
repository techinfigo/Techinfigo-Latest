# Copy to .env.local and fill in real values. .env.local is gitignored via "*.local".
#
# NOTE: nothing in the app reads these yet — no analytics scripts are wired up.
# Setting them alone will not enable tracking.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Meta (Facebook) Pixel ID, e.g. 123456789012345
NEXT_PUBLIC_META_PIXEL_ID=
