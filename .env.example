# Copy to .env.local and fill in real values. .env.local is gitignored via "*.local".
#
# All three are optional. components/Analytics.tsx renders each vendor's script
# only when its ID is non-empty, so nothing loads — and no third-party request
# is made — until the corresponding variable below is set. Leaving them blank
# is a supported configuration, not a broken one.
#
# These are NEXT_PUBLIC_*, so they are inlined into the client bundle at build
# time and are readable by anyone. Never put a secret here. Changing one
# requires a rebuild to take effect.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=

# Meta (Facebook) Pixel ID, e.g. 123456789012345
NEXT_PUBLIC_META_PIXEL_ID=

# Microsoft Clarity project ID, e.g. abcdefghij
NEXT_PUBLIC_CLARITY_ID=

# ---------------------------------------------------------------------------
# Admin lead pipeline (/admin). All optional: with none of these set the site
# builds and serves normally, forms keep working, and every submission is still
# mirrored to the inbox — only the queryable pipeline is unavailable.
# These are server-only. Never prefix them with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon or Supabase both work unchanged).
# Supabase: use the pooler URL. Then run `npm run db:push`.
DATABASE_URL=

# Generate both with: npm run admin:hash -- "your-password-here"
# ADMIN_PASSWORD_HASH is "salt:hash" (scrypt). The password itself is never stored.
ADMIN_PASSWORD_HASH=

# Signs the admin session JWT. Must be at least 32 characters.
# Changing it invalidates every existing session.
ADMIN_SESSION_SECRET=
