# Copy to .env.local and fill in real values. .env.local is gitignored via "*.local".
#
# All three are optional. components/Analytics.tsx renders each vendor's script
# only when its ID is non-empty, so nothing loads — and no third-party request
# is made — until the corresponding variable below is set. Leaving them blank
# is a supported configuration, not a broken one.
#
# These are NEXT_PUBLIC_*, so they are inlined into the client bundle at build
# time and are readable by anyone. Never put a secret here. Changing one
# requires a rebuild to take effect.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=

# Meta (Facebook) Pixel ID, e.g. 123456789012345
NEXT_PUBLIC_META_PIXEL_ID=

# Microsoft Clarity project ID, e.g. abcdefghij
NEXT_PUBLIC_CLARITY_ID=
