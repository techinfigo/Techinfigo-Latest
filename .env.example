# Copy to .env.local and fill in real values. .env.local is gitignored via "*.local".
#
# All three are optional. components/Analytics.tsx renders each vendor's script
# only when its ID is non-empty, so nothing loads — and no third-party request
# is made — until the corresponding variable below is set. Leaving them blank
# is a supported configuration, not a broken one.
#
# These are NEXT_PUBLIC_*, so they are inlined into the client bundle at build
# time and are readable by anyone. Never put a secret here. Changing one
# requires a rebuild to take effect.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=

# Meta (Facebook) Pixel ID, e.g. 123456789012345
NEXT_PUBLIC_META_PIXEL_ID=

# Microsoft Clarity project ID, e.g. abcdefghij
NEXT_PUBLIC_CLARITY_ID=

# ---------------------------------------------------------------------------
# Admin lead pipeline (/admin). All optional: with none of these set the site
# builds and serves normally, forms keep working, and every submission is still
# mirrored to the inbox — only the queryable pipeline is unavailable.
# See ADMIN.md for the full setup, including index deployment.
# These are server-only. Never prefix them with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Firebase service account for the Firestore lead store. All three come from a
# service-account JSON key: Firebase console → Project settings → Service
# accounts → Generate new private key. Copy the values out of the file and then
# delete it — a key file in the repo is a live credential.
#
# FIREBASE_PRIVATE_KEY is a multi-line PEM squeezed onto one line: keep the
# literal \n escapes and the surrounding double quotes exactly as they appear in
# the JSON. lib/firestore.ts unescapes them at runtime.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# Generate both with: npm run admin:hash -- "your-password-here"
# ADMIN_PASSWORD_HASH is "salt:hash" (scrypt). The password itself is never stored.
ADMIN_PASSWORD_HASH=

# Signs the admin session JWT. Must be at least 32 characters.
# Changing it invalidates every existing session.
ADMIN_SESSION_SECRET=

# --- Sign in with Google (admin panel) ---
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type "Web application"). Authorised redirect URI:
#   https://www.techinfigo.com/api/admin/google/callback
# When both are set, the login page shows "Sign in with Google" and the
# password form becomes a fallback behind "Use password instead".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google accounts allowed into /admin.
# Defaults to thetechinfigo@gmail.com when unset.
ADMIN_ALLOWED_EMAILS=

# --- Website enquiries -> Techinfigo CRM (Firebase project "techinfigocrm") ---
# From Firebase console (techinfigocrm) -> Project settings -> Service accounts
# -> Generate new private key. Copy the three values, keep \n escapes intact.
CRM_FIREBASE_PROJECT_ID=
CRM_FIREBASE_CLIENT_EMAIL=
CRM_FIREBASE_PRIVATE_KEY=

# --- Spam protection: Cloudflare Turnstile (invisible bot check) ---
# From dash.cloudflare.com -> Turnstile -> Add widget (domain techinfigo.com,
# mode "Invisible"). The site key is public; the secret key is private.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
